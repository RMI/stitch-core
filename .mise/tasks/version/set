#!/usr/bin/env bash
#MISE description = "Set version numbers for packages. Sets all member packages if `--package` not passed."
#MISE alias="vset"
#USAGE arg "<version>" help="The full version to set."
#USAGE flag "-p --package <pkg>" help="The name of the package to set."
set -euxo pipefail

if [[ -z "${usage_package:-}" ]]; then
  packages="$(mise workspace:packages)"
  for package in $packages; do
    uv version --package "$package" "$usage_version" --frozen
  done
else
  uv version --package "$usage_package" "$usage_version" --frozen
fi
uv lock
